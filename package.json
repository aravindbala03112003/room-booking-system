{
  "name": "hotel-room-booking-system",
  "version": "1.0.0",
  "description": "Full-Stack Hotel Room Booking System with React, Express, and PostgreSQL",
  "private": true,
  "scripts": {
    "build": "cd frontend && npm install && npm run build",
    "seed": "cd backend && npm run seed",
