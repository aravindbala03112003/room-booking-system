# Server Port
PORT=5000

# Managed PostgreSQL Connection String (Recommended for production on Neon / Supabase / Render)
# Example: postgresql://username:password@ep-sample-12345.us-east-2.aws.neon.tech/hotel_booking_db?sslmode=require
DATABASE_URL=

# Or individual PostgreSQL parameters (used if DATABASE_URL is not set)
PGUSER=postgres
PGHOST=localhost
PGPASSWORD=your_postgres_password
PGDATABASE=hotel_booking_db
PGPORT=5432
DATABASE_SSL=false

# Authentication Secrets (Generate a long, secure random key in production)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Allowed frontend origin for CORS in production (e.g. https://your-project.vercel.app)
CLIENT_URL=
ALLOWED_ORIGINS=
